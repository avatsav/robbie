#!/bin/sh
# Check the working tree without modifying files or staging anything.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: Cargo is required. Install the Rust toolchain first." >&2
    exit 1
fi

echo "Checking Rust formatting..."
if ! cargo fmt --all -- --check; then
    echo "pre-commit: Run 'cargo fmt --all', stage the changes, and retry." >&2
    exit 1
fi

echo "Running Clippy..."
cargo clippy --locked --workspace --all-targets --all-features -- -D warnings
